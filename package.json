    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@stdlib/stats-lowess": "^0.2.3",
    "@tanstack/react-router": "^1.170.32",
    "@types/katex": "^0.16.8",
    "katex": "^0.18.4",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.35",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.126.0"
  },
  "allowScripts": {
    "workerd@1.20260825.1": true
  }
